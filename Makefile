# Makefile for python interface for package .
# File is generated by gopy. Do not edit.
# gopy pkg ../jarvis-proto/

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=/Users/max/.local/share/mise/installs/python/latest/bin/python
LIBEXT=.so

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-I/Users/max/.local/share/mise/installs/python/3.14.6/include/python3.14"
LDFLAGS = "-L/Users/max/.local/share/mise/installs/python/3.14.6/lib" "-lpython3.14" -ldl -framework CoreFoundation

all: gen build

gen:
	gopy pkg -no-make ../jarvis-proto/

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm .c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w .go
	# generate _go$(LIBEXT) from .go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o _go$(LIBEXT) .go
	# use pybindgen to build the .c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated .py python wrapper imports this c-code package

	$(GCC) .c -dynamiclib _go$(LIBEXT) -o _$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w

