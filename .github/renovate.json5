{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // org shared config - https://github.com/indykite/ops-common/blob/master/.github/renovate.json
    "github>indykite/ops-common//.github/renovate.json"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pep621",
    "helmv3",
    "custom.regex"
  ],
  "ignorePaths": [],
  "ignorePresets": [
    "group:monorepos",
    "group:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned bitnami/redis image digest for the chart-managed Redis subchart",
      "managerFilePatterns": [
        "/(?:^|\\/)chart\\/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*image:\\s*\\n\\s*tag:\\s*(?<currentValue>\\S+)\\s*\\n\\s*digest:\\s*[\"']?(?<currentDigest>sha256:[a-f0-9]+)[\"']?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}"
    }
  ],
  // "All rules are applied, so this effectively means it’s the last matching group that takes effect"
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "SemVer Major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "SemVer Minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "bump"
      ],
      "addLabels": [
        "SemVer Patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "bump"
      ],
      "groupName": "mlops patch dependencies",
      "groupSlug": "mlops-patch",
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "bump"
      ],
      "groupName": "pep621 patch dependencies",
      "groupSlug": "pep621-patch",
      "matchManagers": [
        "pep621"
      ]
    },
    {
      /*
      Python version is pinned. If it is updated, it must happen in multiple places:
      - Dockerfile
      - pyproject.toml
      - Github Workflows
      */
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      /*
      Python version is pinned. If it is updated, it must happen in multiple places:
      - Dockerfile
      - pyproject.toml
      - Github Workflows
      */
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
