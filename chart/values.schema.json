{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indykiteBaseUrl",
        "introspectUrl",
        "introspectClientId",
        "geminiApiKeySecretRef",
        "introspectClientSecretRef",
        "ikAppAgentKeySecretRef"
      ],
      "properties": {
        "intentPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "intentAgentName": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "geminiModel": {
          "type": "string",
          "minLength": 1
        },
        "fetchExecutorMaxWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "toolCallMaxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "schemaPreviewChars": {
          "type": "integer",
          "minimum": 1
        },
        "llmTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requestTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "validationMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "indykiteBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "minLength": 1
        },
        "schemaFetchTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "schemaRefreshTtlMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "policyFetchTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "policyRefreshTtlMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "policyFetchRetryAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "policyPreviewChars": {
          "type": "integer",
          "minimum": 1
        },
        "introspectUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "minLength": 1
        },
        "introspectClientId": {
          "type": "string",
          "minLength": 1
        },
        "introspectTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expectedTokenAudience": {
          "type": "string",
          "minLength": 1
        },
        "auditDelivery": {
          "type": "string",
          "enum": [
            "file",
            "webhook"
          ]
        },
        "auditAsync": {
          "type": "boolean"
        },
        "auditAsyncBufferSize": {
          "type": "integer",
          "minimum": 1
        },
        "auditFileStoragePath": {
          "type": "string",
          "minLength": 1
        },
        "auditFileFormat": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "txt"
          ]
        },
        "auditFileRotationStrategy": {
          "type": "string",
          "enum": [
            "time",
            "size",
            "size-and-time"
          ]
        },
        "auditFileRotationIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "auditFileRotationMaxBytes": {
          "type": "integer",
          "minimum": 1
        },
        "auditHttpUrl": {
          "type": "string"
        },
        "auditHttpMethod": {
          "type": "string",
          "enum": [
            "POST",
            "PUT"
          ]
        },
        "auditHttpAuthType": {
          "type": "string",
          "enum": [
            "mTLS",
            "no-auth",
            "api-key"
          ]
        },
        "auditHttpApiKeyHeader": {
          "type": "string",
          "minLength": 1
        },
        "auditHttpTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "auditHttpApiKeySecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "auditHttpMtlsCertificateFilePath": {
          "type": "string"
        },
        "auditHttpMtlsPrivateKeyPath": {
          "type": "string"
        },
        "geminiApiKeySecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "introspectClientSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cacheBackend": {
          "type": "string",
          "enum": [
            "memory",
            "redis"
          ]
        },
        "ikAppAgentKeySecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "redisUrlSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "envFromSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "envVarName",
              "secretName",
              "secretKey"
            ],
            "properties": {
              "envVarName": {
                "type": "string",
                "minLength": 1
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "secretKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "advertisedUrl": {
          "type": "string",
          "pattern": "^(https?://\\S+)?$"
        }
      }
    },
    "redis": {
      "type": "object",
      "description": "Chart-managed Redis (Bitnami subchart) config. Deliberately not additionalProperties:false and not otherwise schematized here, unlike the rest of this file - keys beyond \"enabled\" belong to the vendored bitnami/redis subchart's own values contract, which ships and enforces its own values.schema.json. Duplicating/pinning that contract here would drift on every subchart version bump.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            },
            "ephemeral-storage": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            },
            "ephemeral-storage": {
              "type": "string"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "memoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        }
      }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destinationRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "virtualService": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gateways": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retries": {
              "type": "object"
            },
            "headers": {
              "type": "object"
            }
          }
        },
        "authorizationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "principals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "internalCallers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sameNamespace": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "serviceAccounts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "crossNamespace": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "namespace": {
                        "type": "string"
                      },
                      "serviceAccounts": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "rules": {
              "type": "array"
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "methods": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "metricsPeerAuthentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mtlsMode": {
              "type": "string",
              "enum": [
                "UNSET",
                "DISABLE",
                "PERMISSIVE",
                "STRICT"
              ]
            },
            "portLevelMtlsMode": {
              "type": "string",
              "enum": [
                "UNSET",
                "DISABLE",
                "PERMISSIVE",
                "STRICT"
              ]
            }
          }
        },
        "metricsAuthorizationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "principals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    }
  }
}
