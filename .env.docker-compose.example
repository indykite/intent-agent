INTENT_PORT=6003
HEALTH_PORT=8001
BIND_HOST=0.0.0.0
ADVERTISED_HOST=intent
INTENT_AGENT_NAME=intent_agent
LOG_LEVEL=DEBUG

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TOOL_CALL_MAX_ITERATIONS=5
SCHEMA_PREVIEW_CHARS=12000

INDYKITE_BASE_URL=
IK_APP_AGENT_KEY=
SCHEMA_FETCH_TIMEOUT_SECONDS=30.0
SCHEMA_REFRESH_TTL_MINUTES=1440.0

CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379

INTROSPECT_URL=http://host.docker.internal:9001/introspect
INTROSPECT_CLIENT_ID=test-client
INTROSPECT_CLIENT_SECRET=test-secret
INTROSPECT_TIMEOUT_SECONDS=5.0

SUBJECT_TYPE=
