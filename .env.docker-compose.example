INTENT_PORT=6003
HEALTH_PORT=8001
BIND_HOST=0.0.0.0
ADVERTISED_HOST=intent
INTENT_AGENT_NAME=intent_agent
LOG_LEVEL=DEBUG

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TOOL_CALL_MAX_ITERATIONS=5
SCHEMA_PREVIEW_CHARS=12000
LLM_TIMEOUT_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=10.0
VALIDATION_MAX_RETRIES=1

INDYKITE_BASE_URL=
IK_APP_AGENT_KEY=
SCHEMA_FETCH_TIMEOUT_SECONDS=3.0
SCHEMA_REFRESH_TTL_MINUTES=5.0

POLICY_FETCH_TIMEOUT_SECONDS=2.0
POLICY_REFRESH_TTL_MINUTES=5.0
POLICY_FETCH_RETRY_ATTEMPTS=2
POLICY_PREVIEW_CHARS=12000

CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379

# A2A task store/queue manager - same memory/redis shape as CACHE_BACKEND/REDIS_URL above.
A2A_TASK_STORE_BACKEND=redis
A2A_TASK_STORE_URL=redis://redis:6379
A2A_TASK_STORE_TTL_MINUTES=1440.0

# Shared by every Redis client above - must not exceed REQUEST_TIMEOUT_SECONDS.
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# How long RedisQueueManager's dequeue_event() blocks per Streams read before retrying.
REDIS_QUEUE_DEQUEUE_BLOCK_SECONDS=1.0

# How long a dequeued-but-unacked entry sits idle before dequeue_event() reclaims it from a
# crashed consumer.
REDIS_QUEUE_RECLAIM_MIN_IDLE_SECONDS=30.0

INTROSPECT_URL=http://host.docker.internal:9001/introspect
INTROSPECT_CLIENT_ID=test-client
INTROSPECT_CLIENT_SECRET=test-secret
INTROSPECT_TIMEOUT_SECONDS=5.0
EXPECTED_TOKEN_AUDIENCE=intent_agent

# Audit log - required. The distroless image has no writable filesystem beyond /tmp, so file
# delivery inside the container goes there (lost when the container is removed - fine for the
# compose smoke test; use AUDIT_DELIVERY=webhook for anything durable).
AUDIT_DELIVERY=file
AUDIT_FILE_STORAGE_PATH=/tmp/audit
AUDIT_FILE_FORMAT=json
AUDIT_FILE_ROTATION_STRATEGY=size-and-time
