INTENT_PORT=6003
HEALTH_PORT=8001
BIND_HOST=0.0.0.0
ADVERTISED_HOST=intent
INTENT_AGENT_NAME=intent_agent
LOG_LEVEL=DEBUG

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TOOL_CALL_MAX_ITERATIONS=5
SCHEMA_PREVIEW_CHARS=12000
LLM_TIMEOUT_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=10.0
VALIDATION_MAX_RETRIES=1

INDYKITE_BASE_URL=
IK_APP_AGENT_KEY=
SCHEMA_FETCH_TIMEOUT_SECONDS=30.0
SCHEMA_REFRESH_TTL_MINUTES=5.0

# CACHE_BACKEND=memory (the default) uses an in-process cache; REDIS_URL is only required
# when CACHE_BACKEND=redis. Example when enabled: CACHE_BACKEND=redis / REDIS_URL=redis://localhost:6379
CACHE_BACKEND=memory
REDIS_URL=

INTROSPECT_URL=
INTROSPECT_CLIENT_ID=
INTROSPECT_CLIENT_SECRET=
INTROSPECT_TIMEOUT_SECONDS=5.0

# Audit log (TDD 4.9): every request produces one record, so AUDIT_DELIVERY is required - `file` or
# `webhook`, the same delivery types as the Agent Gateway's `audit.` config. AUDIT_ASYNC=true
# buffers records in memory (AUDIT_ASYNC_BUFFER_SIZE, default 512) behind a background worker and
# drops them with a warning when the buffer is full.
AUDIT_DELIVERY=file
AUDIT_ASYNC=false
AUDIT_ASYNC_BUFFER_SIZE=512
# AUDIT_DELIVERY=file: files named audit-<INTENT_AGENT_NAME>-<unixNano>.<format> under the storage
# path (created if missing); format csv / json / txt; rotation time / size / size-and-time.
AUDIT_FILE_STORAGE_PATH=./.private/audit
AUDIT_FILE_FORMAT=json
AUDIT_FILE_ROTATION_STRATEGY=size-and-time
AUDIT_FILE_ROTATION_INTERVAL_SECONDS=86400
AUDIT_FILE_ROTATION_MAX_BYTES=104857600
# AUDIT_DELIVERY=webhook: one POST/PUT per record with the record as the JSON body.
# AUDIT_HTTP_AUTH_TYPE is one of mTLS (needs both file paths) / api-key (needs AUDIT_HTTP_API_KEY) / no-auth.
AUDIT_HTTP_URL=
AUDIT_HTTP_METHOD=POST
AUDIT_HTTP_AUTH_TYPE=no-auth
AUDIT_HTTP_MTLS_CERTIFICATE_FILE_PATH=
AUDIT_HTTP_MTLS_PRIVATE_KEY_PATH=
AUDIT_HTTP_API_KEY=
AUDIT_HTTP_API_KEY_HEADER=X-API-Key
AUDIT_HTTP_TIMEOUT_SECONDS=5.0
