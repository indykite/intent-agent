INTENT_PORT=6003
HEALTH_PORT=8001
BIND_HOST=0.0.0.0
ADVERTISED_HOST=intent
INTENT_AGENT_NAME=intent_agent
LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TOOL_CALL_MAX_ITERATIONS=5
SCHEMA_PREVIEW_CHARS=12000

INDYKITE_BASE_URL=
IK_APP_AGENT_KEY=
SCHEMA_FETCH_TIMEOUT_SECONDS=30.0
SCHEMA_REFRESH_TTL_MINUTES=1440.0

# Blank REDIS_URL disables Redis - the schema cache falls back to an in-process cache.
# Example when enabled: REDIS_URL=redis://localhost:6379
REDIS_URL=

INTROSPECT_URL=
INTROSPECT_CLIENT_ID=
INTROSPECT_CLIENT_SECRET=
INTROSPECT_TIMEOUT_SECONDS=5.0

SUBJECT_TYPE=
