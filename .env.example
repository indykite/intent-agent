INTENT_PORT=6003
HEALTH_PORT=8001
BIND_HOST=0.0.0.0
ADVERTISED_HOST=intent
INTENT_AGENT_NAME=intent_agent
LOG_LEVEL=DEBUG

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TOOL_CALL_MAX_ITERATIONS=5
SCHEMA_PREVIEW_CHARS=12000
LLM_TIMEOUT_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=10.0
VALIDATION_MAX_RETRIES=1

INDYKITE_BASE_URL=
IK_APP_AGENT_KEY=
SCHEMA_FETCH_TIMEOUT_SECONDS=30.0
SCHEMA_REFRESH_TTL_MINUTES=5.0

# CACHE_BACKEND=memory (the default) uses an in-process cache; REDIS_URL is only required
# when CACHE_BACKEND=redis. Example when enabled: CACHE_BACKEND=redis / REDIS_URL=redis://localhost:6379
CACHE_BACKEND=memory
REDIS_URL=

INTROSPECT_URL=
INTROSPECT_CLIENT_ID=
INTROSPECT_CLIENT_SECRET=
INTROSPECT_TIMEOUT_SECONDS=5.0

SUBJECT_TYPE=
