# Makefile for python interface for package audit.
# File is generated by gopy. Do not edit.
# gopy pkg ../jarvis-proto/services/agent-gateway/internal/audit

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=/Users/max/.local/share/mise/installs/python/latest/bin/python
LIBEXT=.so

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-I/Users/max/.local/share/mise/installs/python/3.14.6/include/python3.14"
LDFLAGS = "-L/Users/max/.local/share/mise/installs/python/3.14.6/lib" "-lpython3.14" -ldl -framework CoreFoundation

all: gen build

gen:
	gopy pkg -no-make ../jarvis-proto/services/agent-gateway/internal/audit

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm audit.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w audit.go
	# generate audit_go$(LIBEXT) from audit.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o audit_go$(LIBEXT) audit.go
	# use pybindgen to build the audit.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _audit$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated audit.py python wrapper imports this c-code package

	$(GCC) audit.c -dynamiclib audit_go$(LIBEXT) -o _audit$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w

